; Per-environment runtime initialization forms.
; This file is embedded into libListTalkVM and evaluated for every base
; environment that is initialized.

(ListTalk:in-package :ListTalk-implementation)
(ListTalk:use-package :ListTalk)

(%define ListTalk:define-constant
  (macro
    (%lambda 'define-constant (target . body)
      "Define a constant value or function."
      (if (pair? target)
          `(%define-constant ,(car target) (%lambda ',(car target) ,(cdr target) ,@body))
          `(%define-constant ,target ,(car body))))))

(%define ListTalk:define-macro
  (macro
    (%lambda 'define-macro (target . body)
      "Define a macro from a signature or macro object."
      (if (pair? target)
          `(%define-constant
             ,(car target)
             (macro (%lambda ',(list 'macro (car target)) ,(cdr target) ,@body)))
          `(%define-constant ,target (macro ,(car body)))))))

(ListTalk:define-macro (ListTalk:lambda parameters . body)
  "Construct an anonymous closure."
  `(%lambda '() ,parameters ,@body))

(ListTalk:define-constant ListTalk:λ ListTalk:lambda)

(ListTalk:define-macro (ListTalk:delay expression)
  "Create a promise for expression without evaluating it."
  `(ListTalk:send ListTalk:Promise :delay: (ListTalk:lambda () ,expression)))

(ListTalk:define-macro (ListTalk:let bindings-or-name . body)
  "Evaluate body with lexical bindings, or create and call a named local function."
  (if (symbol? bindings-or-name)
      `(letrec ((,bindings-or-name
                 (ListTalk-implementation:%lambda ',bindings-or-name
                                                  ,(map car (car body))
                                                  ,@(cdr body))))
         (,bindings-or-name
          ,@(map cadr (car body))))
      `(ListTalk-implementation:%let ,bindings-or-name ,@body)))

(ListTalk:define-macro (ListTalk:let* bindings . body)
  "Evaluate body with sequential lexical bindings."
  (if (null? bindings)
      `(ListTalk-implementation:%let () ,@body)
      `(ListTalk-implementation:%let (,(car bindings))
         (let* ,(cdr bindings) ,@body))))

(ListTalk:define-macro (ListTalk:while condition . body)
  "Evaluate body while condition is truthy, with break and continue in scope."
  (let ((break-tag (gensym 'while-break))
        (continue-tag (gensym 'while-continue))
        (continuing (gensym 'while-continuing)))
    `(let ((,continuing #false))
       (catch ',break-tag
         (let ((ListTalk:break (lambda results
                                 (throw ',break-tag
                                        (if (null? results)
                                            #true
                                            (if (null? (cdr results))
                                                (car results)
                                                results)))))
               (ListTalk:continue (lambda ()
                                    (ListTalk:set! ,continuing #true)
                                    (throw ',continue-tag #true))))
           (ListTalk-implementation:%while
             (catch ',continue-tag
               (ListTalk:set! ,continuing #false)
               ,condition)
             (if ,continuing
                 #nil
                 (catch ',continue-tag
                   ,@body))))))))

(ListTalk:define-macro (ListTalk:define target . body)
  "Define a value, function, or dynamic variable."
  (if (pair? target)
      (if (eq? (car target) 'ListTalk-implementation:%dynamic-ref)
          `(%define-constant ,(cadr target) [DynamicVariable new: ,(car body)])
          `(%define-constant ,(car target) (%lambda ',(car target) ,(cdr target) ,@body)))
      `(%define ,target ,(car body))))

(ListTalk:define (ListTalk:force future)
  "Force future and return its value."
  [future force!])

(ListTalk:define-macro (%closure . forms)
  "Construct an anonymous closure from curly-brace reader syntax."
  (define (expand remaining reversed-parameters)
    (if (pair? remaining)
        (if (symbol? (car remaining))
            (expand (cdr remaining) (cons (car remaining) reversed-parameters))
            `(%lambda '() ,(reverse reversed-parameters) ,@remaining))
        (if (null? reversed-parameters)
            `(%lambda '() () #nil)
            `(%lambda '()
                      ,(reverse (cdr reversed-parameters))
                      ,(car reversed-parameters)))))
  (expand forms '()))

(ListTalk:define-macro (ListTalk-implementation:%self-slot slot-name)
  "Expand method-local slot shorthand to a self slot reference."
  `(slot-ref ListTalk:self ',slot-name))

(ListTalk:define-macro (ListTalk:set! target value)
  "Set a lexical variable, self slot, or dynamic variable."
  (if (symbol? target)
      `(%set! ,target ,value)
      (if (pair? target)
          (if (eq? (car target) 'ListTalk-implementation:%self-slot)
              `(slot-set! ListTalk:self ',(cadr target) ,value)
              (if (eq? (car target) 'ListTalk-implementation:%dynamic-ref)
                  `(ListTalk-implementation:%send ,(cadr target) :value: ,value)
                  (error "set! unsupported target")))
          (error "set! unsupported target"))))

(ListTalk:define-macro (ListTalk:define-class name superclasses slot-names . options)
  "Define a class with superclasses, slot names, and optional documentation."
  (define documentation
    (cond
      ((null? options) #nil)
      ((and (pair? options)
            (eq? (car options) :documentation)
            (pair? (cdr options))
            (null? (cddr options)))
       (cadr options))
      (#true
       (error "define-class expects optional :documentation string"))))
  `(define ,name
     (make-class ',name
                 (list ,@superclasses)
                 ',slot-names
                 :documentation ,documentation)))

(ListTalk:define-macro (ListTalk:define-method signature . body)
  "Define a single-dispatch method or a method on a generic function."
  (define (generic-parameter-name parameter)
    (if (symbol? parameter)
        parameter
        (if (and (pair? parameter)
                 (pair? (cdr parameter))
                 (null? (cddr parameter))
                 (symbol? (car parameter)))
            (car parameter)
            (error "Generic method parameter expects name or (name class)"))))
  (define (generic-parameter-specializer parameter)
    (if (symbol? parameter)
        'ListTalk:Object
        (cadr parameter)))
  (define (generic-expansion generic-signature qualifier method-body)
    (if (and (pair? generic-signature)
             (symbol? (car generic-signature)))
        (let ((generic-name (car generic-signature))
              (parameters (cdr generic-signature)))
          `(ListTalk:send
             ,generic-name
             :addMethod:
             (ListTalk:send
               ListTalk:GenericMethod
               :newQualifier:specializers:function:
               ,qualifier
               (ListTalk:list
                 ,@(map generic-parameter-specializer parameters))
               (ListTalk-implementation:%lambda
                 '(,generic-name ,qualifier)
                 ,(map generic-parameter-name parameters)
                 ,@method-body))))
        (error "Generic define-method expects (name parameter ...) signature")))
  (if (pair? signature)
      (if (eq? (car signature) 'ListTalk:send)
          `[,(cadr signature)
            addMethod: (%lambda '(,(cadr signature) >> ,(caddr signature))
                                (ListTalk:self ,@(cdddr signature))
                         ,@body)
            withSelector: ,(caddr signature)]
          (if (and (pair? (cdr signature))
                   (or (eq? (cadr signature) :before)
                       (eq? (cadr signature) :after)
                       (eq? (cadr signature) :around)
                       (eq? (cadr signature) :primary)))
              (generic-expansion
                (cons (car signature) (cddr signature))
                (cadr signature)
                body)
              (generic-expansion signature :primary body)))
      (if (or (eq? signature :before)
              (eq? signature :after)
              (eq? signature :around)
              (eq? signature :primary))
          (if (pair? body)
              (generic-expansion (car body) signature (cdr body))
              (error "Qualified define-method requires a signature"))
          (error "define-method expects method signature"))))

(ListTalk:define-macro (ListTalk:define-generic signature
                       :key documentation method-combination)
  "Define a generic function with optional documentation and method combination."
  (if (and (pair? signature)
           (symbol? (car signature))
           (every symbol? (cdr signature)))
      `(%define
         ,(car signature)
         (ListTalk:send
           ListTalk:GenericFunction
           :newNamed:parameters:documentation:methodCombination:
           ',(car signature)
           ',(cdr signature)
           ,documentation
           ,method-combination))
      (error "define-generic expects (name parameter ...) signature")))

(ListTalk:define-macro (ListTalk:define-constructor signature . body)
  "Define a class-side constructor and matching instance initializer."
  (define (init-selector selector)
    "Return initializer selector corresponding to constructor selector."
    (let ((name [selector name]))
      (if [selector nameStartsWith?: "new"]
          [Symbol keyword: (string-append "init" (substring name 3 [name length]))]
          (if [selector nameStartsWith?: "from"]
              [Symbol keyword: (string-append "initFrom" (substring name 4 [name length]))]
              (error "define-constructor selector must start with new or from")))))
  (if (pair? signature)
      (if (eq? (car signature) 'ListTalk:send)
          (let ((class (cadr signature))
                (constructor-selector (caddr signature))
                (arguments (cdddr signature)))
            (let ((initializer-selector (init-selector constructor-selector)))
              `(begin
                 (define-method
                   ,(cons 'ListTalk:send
                          (cons (list 'ListTalk:send class ':class)
                                (cons constructor-selector arguments)))
                   (let ((instance [ListTalk:self alloc]))
                     ,(cons 'ListTalk:send
                            (cons 'instance
                                  (cons initializer-selector arguments)))))
                 (define-method
                   ,(cons 'ListTalk:send
                          (cons class
                                (cons initializer-selector arguments)))
                   ,@body
                   ListTalk:self))))
          (error "define-constructor expects [Class selector ...] signature"))
      (error "define-constructor expects [Class selector ...] signature")))

(ListTalk:define-macro (ListTalk:send receiver selector . arguments)
  "Send selector to receiver, handling super sends specially."
  (if (and (symbol? receiver)
          (eq? receiver 'ListTalk:super))
      `(ListTalk-implementation:%super-send
         ListTalk:self
         ,selector
         ,@arguments)
      `(ListTalk-implementation:%send ,receiver ,selector ,@arguments)))

(ListTalk:define-macro (ListTalk:provide module)
  "Record module as provided and return its name."
  `(if (memq ',module ListTalk:%modules)
       ',module
       (let ()
         (set! ListTalk:%modules (cons ',module ListTalk:%modules))
         ',module)))

(ListTalk:define-macro (ListTalk:load! module . resolvers)
  "Load module using optional resolver paths before configured resolvers."
  (if (null? resolvers)
      `(ListTalk-implementation:%load!
         (get-current-environment)
         ',module
         ListTalk:module-resolvers)
      `(ListTalk-implementation:%load!
         (get-current-environment)
         ',module
         (append ',resolvers ListTalk:module-resolvers))))

(ListTalk:define-macro (ListTalk:require module . resolvers)
  "Load module unless already provided."
  (if (null? resolvers)
      `(ListTalk-implementation:%require
         (get-current-environment)
         ',module
         ListTalk:module-resolvers)
      `(ListTalk-implementation:%require
         (get-current-environment)
         ',module
         (append ',resolvers ListTalk:module-resolvers))))

; TODO: delalamoize this
(ListTalk:define-macro (ListTalk:with-gensyms symbols . body)
  "Evaluate body with symbols bound to fresh generated symbols."
  (let ()
    (define (expand remaining)
      "Expand remaining symbol bindings into nested lambdas."
      (if (null? remaining)
          `((lambda () ,@body))
          `((lambda (,(car remaining))
              ,(expand (cdr remaining)))
            (gensym))))
    (expand symbols)))

(ListTalk:define-macro (ListTalk:dynamic-let bindings . body)
  "Temporarily bind dynamic variables during body."
  (define (dynamic-ref-form? form)
    "Return true when form refers to a dynamic variable."
    (and (pair? form)
         (eq? (car form) 'ListTalk-implementation:%dynamic-ref)))
  (define (expand remaining old-bindings value-bindings set-forms restore-forms)
    "Expand dynamic-let bindings into lexical temporaries and unwind cleanup."
    (if (null? remaining)
        `(let ,(append old-bindings value-bindings)
           (unwind-protect
             (begin ,@set-forms ,@body)
             ,@restore-forms))
        (let ((binding (car remaining)))
          (if (pair? binding)
              (if (dynamic-ref-form? (car binding))
                  (if (null? (cddr binding))
                      (let ((old-value (gensym))
                            (new-value (gensym)))
                        (expand
                          (cdr remaining)
                          (append old-bindings `((,old-value ,(car binding))))
                          (append value-bindings `((,new-value ,(cadr binding))))
                          (append set-forms `((set! ,(car binding) ,new-value)))
                          (append restore-forms `((set! ,(car binding) ,old-value)))))
                      (error "dynamic-let binding expects target and value"))
                  (error "dynamic-let binding target must be dynamic variable"))
              (error "dynamic-let binding must be pair")))))
  (expand bindings '() '() '() '()))

(ListTalk:define-macro (ListTalk:restart-bind clause . body)
  "Bind one restart during body."
  `(ListTalk-implementation:%restart-bind
     ,(cond
        ((not (pair? clause))
         clause)
        ((null? (cdr clause))
         (car clause))
        ((pair? (car clause))
         `[Restart fromClosure:
           (ListTalk-implementation:%lambda
             ',(caar clause)
             ,(cdar clause)
             ,@(cdr clause))])
        ((null? (cddr clause))
         `[Restart named: ',(car clause) fromClosure: ,(cadr clause)])
        (#true
         (error "restart-bind clause expects restart expression, name and closure, or restart signature")))
     ,@body))

(define-macro (ListTalk:when condition . body)
  "Evaluate body when condition is truthy."
  `(if ,condition
       (begin ,@body)))

(define-macro (ListTalk:unless condition . body)
  "Evaluate body when condition is falsey."
  `(if ,condition
       #nil
       (begin ,@body)))

(define-macro (ListTalk:with-mutex mutex . body)
  "Evaluate body with mutex locked, unlocking on exit."
  `[,mutex do: (ListTalk-implementation:%lambda '() () ,@body)])

(define-macro (ListTalk:with-read-lock rwlock . body)
  "Evaluate body with read lock held, unlocking on exit."
  `[,rwlock readDo: (ListTalk-implementation:%lambda '() () ,@body)])

(define-macro (ListTalk:with-write-lock rwlock . body)
  "Evaluate body with write lock held, unlocking on exit."
  `[,rwlock writeDo: (ListTalk-implementation:%lambda '() () ,@body)])

(define-macro (ListTalk:define-mutex name)
  "Define a mutex with the given name."
  `(define ,name [Mutex new: ',name]))
(define-macro (ListTalk:define-rwlock name)
  "Define a read-write lock with the given name."
  `(define ,name [ReadWriteLock new: ',name]))
(define-macro (ListTalk:define-condition-variable name)
  "Define a condition variable with the given name."
  `(define ,name [ConditionVariable new: ',name]))
(define-macro (ListTalk:define-message-queue name capacity)
  "Define a message queue with the given name."
  `(define ,name [MessageQueue new: ,capacity named:',name]))

;;; Generic functions are ordinary Function instances whose protocol forms the
;;; metaobject interface.  Only invoking a method needs VM help, to establish
;;; the invocation context consumed by call-next-method.

(ListTalk:define-class ListTalk:GenericMethod (ListTalk:Object)
  (qualifier specializers function))

(ListTalk:define-constructor
  [ListTalk:GenericMethod newQualifier: qualifier
                          specializers: specializers
                          function: function]
  (if (or (eq? qualifier :primary)
          (eq? qualifier :before)
          (eq? qualifier :after)
          (eq? qualifier :around))
      #true
      (error "Generic method has invalid qualifier"))
  (if (every class? specializers)
      #true
      (error "Generic method specializers must be classes"))
  (if (function? function)
      #true
      (error "Generic method implementation must be function"))
  (set! .qualifier qualifier)
  (set! .specializers specializers)
  (set! .function function))

(ListTalk:define-method [ListTalk:GenericMethod qualifier]
  .qualifier)

(ListTalk:define-method [ListTalk:GenericMethod specializers]
  .specializers)

(ListTalk:define-method [ListTalk:GenericMethod function]
  .function)

(ListTalk:define-method [ListTalk:GenericMethod documentation]
  [.function documentation])

(ListTalk:define-method [ListTalk:GenericMethod arguments]
  [.function arguments])

(ListTalk:define
  (ListTalk-implementation:%generic-class-position class classes)
  (let loop ((remaining classes) (position 0))
    (if (null? remaining)
        #nil
        (if (eq? class (car remaining))
            position
            (loop (cdr remaining) (+ position 1))))))

(ListTalk:define-method
  [ListTalk:GenericMethod applicableToArguments: arguments]
  (if (= (length .specializers) (length arguments))
      (every
        (lambda (specializer argument)
          (memq specializer [(type-of argument) precedenceList]))
        .specializers
        arguments)
      #false))

(ListTalk:define
  (ListTalk-implementation:%compare-generic-specializers
    left-specializers right-specializers arguments)
  (if (null? arguments)
      0
      (let ((left-position
              (ListTalk-implementation:%generic-class-position
                (car left-specializers)
                [(type-of (car arguments)) precedenceList]))
            (right-position
              (ListTalk-implementation:%generic-class-position
                (car right-specializers)
                [(type-of (car arguments)) precedenceList])))
        (if (< left-position right-position)
            -1
            (if (> left-position right-position)
                1
                (ListTalk-implementation:%compare-generic-specializers
                  (cdr left-specializers)
                  (cdr right-specializers)
                  (cdr arguments)))))))

(ListTalk:define-method
  [ListTalk:GenericMethod compareSpecificityWith: other
                          forArguments: arguments]
  (ListTalk-implementation:%compare-generic-specializers
    .specializers
    [other specializers]
    arguments))

(ListTalk:define-method
  [ListTalk:GenericMethod invokeWithArguments: arguments
                          nextMethod: next-method]
  (ListTalk-implementation:%apply-generic-method
    .function arguments next-method))

(ListTalk:define-class ListTalk:GenericFunction (ListTalk:Function)
  (name parameters documentation methods method-combination))

(ListTalk:define-constructor
  [ListTalk:GenericFunction newNamed: name
                            parameters: parameters
                            documentation: documentation
                            methodCombination: method-combination]
  (if (symbol? name)
      #true
      (error "Generic function name must be symbol"))
  (if (every symbol? parameters)
      #true
      (error "Generic function parameters must be symbols"))
  (if (or (null? documentation) (string? documentation))
      #true
      (error "Generic function documentation must be string or nil"))
  (if (or (null? method-combination) (function? method-combination))
      #true
      (error "Method combination must be function or nil"))
  (set! .name name)
  (set! .parameters parameters)
  (set! .documentation documentation)
  (set! .methods '())
  (set! .method-combination method-combination))

(ListTalk:define-method [ListTalk:GenericFunction name]
  .name)

(ListTalk:define-method [ListTalk:GenericFunction parameters]
  .parameters)

(ListTalk:define-method [ListTalk:GenericFunction arguments]
  .parameters)

(ListTalk:define-method [ListTalk:GenericFunction documentation]
  .documentation)

(ListTalk:define-method [ListTalk:GenericFunction methods]
  .methods)

(ListTalk:define-method [ListTalk:GenericFunction methodCombination]
  .method-combination)

(ListTalk:define-method [ListTalk:GenericFunction addMethod: method]
  (if (eq? (type-of method) ListTalk:GenericMethod)
      #true
      (error "GenericFunction>>addMethod: expects GenericMethod"))
  (if (= (length [method specializers]) (length .parameters))
      #true
      (error "Generic method parameter count does not match generic function"))
  (set! .methods
        (cons
          method
          [.methods filter:
            (lambda (existing)
              (not
                (and (eq? [existing qualifier] [method qualifier])
                     (equal? [existing specializers]
                             [method specializers]))))]))
  method)

(ListTalk:define-method
  [ListTalk:GenericFunction computeApplicableMethods: arguments]
  (if (= (length arguments) (length .parameters))
      #true
      (error "Generic function arity mismatch"))
  [[.methods filter:
      (lambda (method) [method applicableToArguments: arguments])]
    sortUsing:
      (lambda (left right)
        [left compareSpecificityWith: right forArguments: arguments])])

(ListTalk:define
  (ListTalk-implementation:%generic-method-chain methods terminal)
  (if (null? methods)
      terminal
      (let ((method (car methods))
            (next
              (ListTalk-implementation:%generic-method-chain
                (cdr methods)
                terminal)))
        (lambda arguments
          [method invokeWithArguments: arguments nextMethod: next]))))

(ListTalk:define
  (ListTalk-implementation:%standard-method-combination methods)
  (let ((around
          [methods filter:
            (lambda (method) (eq? [method qualifier] :around))])
        (before
          [methods filter:
            (lambda (method) (eq? [method qualifier] :before))])
        (primary
          [methods filter:
            (lambda (method) (eq? [method qualifier] :primary))])
        (after
          [methods filter:
            (lambda (method) (eq? [method qualifier] :after))]))
    (let ((core
            (if (null? primary)
                (lambda arguments
                  (error "No applicable primary method"))
                (let ((primary-chain
                        (ListTalk-implementation:%generic-method-chain
                          primary
                          #nil)))
                  (lambda arguments
                    (for-each
                      (lambda (method)
                        [method invokeWithArguments: arguments
                                nextMethod: #nil])
                      before)
                    (let ((result (apply primary-chain arguments)))
                      (for-each
                        (lambda (method)
                          [method invokeWithArguments: arguments
                                  nextMethod: #nil])
                        (reverse after))
                      result))))))
      (ListTalk-implementation:%generic-method-chain around core))))

(ListTalk:define-method
  [ListTalk:GenericFunction computeEffectiveMethod: applicable-methods]
  (let ((effective-method
          (if (null? .method-combination)
              (ListTalk-implementation:%standard-method-combination
                applicable-methods)
              (apply .method-combination (list applicable-methods)))))
    (if (function? effective-method)
        effective-method
        (error "Method combination must return a function"))))

(ListTalk:define-method
  [ListTalk:GenericFunction valueWithArguments: arguments]
  (let ((applicable [ListTalk:self computeApplicableMethods: arguments]))
    (apply [ListTalk:self computeEffectiveMethod: applicable] arguments)))
