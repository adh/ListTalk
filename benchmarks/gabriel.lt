(define (fib n)
  (if (< n 2)
      n
      (+ (fib (- n 1))
         (fib (- n 2)))))

(define (tak x y z)
  (if (not (< y x))
      z
      (tak (tak (- x 1) y z)
           (tak (- y 1) z x)
           (tak (- z 1) x y))))

(define (listn n)
  (if (= n 0)
      '()
      (cons n (listn (- n 1)))))

(define (shorterp x y)
  (if (null? y)
      #false
      (if (null? x)
          #true
          (shorterp (cdr x) (cdr y)))))

(define (mas x y z)
  (if (not (shorterp y x))
      z
      (mas (mas (cdr x) y z)
           (mas (cdr y) z x)
           (mas (cdr z) x y))))

(define benchmark:l18 (listn 18))
(define benchmark:l12 (listn 12))
(define benchmark:l6 (listn 6))

(benchmark:println "benchmark\titerations\tmicroseconds\tresult")
(benchmark:run "fib-20" 20 (lambda () (fib 20)))
(benchmark:run "tak-18-12-6" 10 (lambda () (tak 18 12 6)))
(benchmark:run "takl-18-12-6" 10
  (lambda () (length (mas benchmark:l18 benchmark:l12 benchmark:l6))))
